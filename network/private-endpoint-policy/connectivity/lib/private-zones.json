            "privateDnsZoneName": ["privatelink.api.azureml.ms"]
        },
        {
            "resource": "Cognitive Services",
            "privateLinkResourceType": "Microsoft.CognitiveServices/accounts",
            "subresource": "account",
            "privateDnsZoneName": ["privatelink.cognitiveservices.azure.com"]
        }
    ]
